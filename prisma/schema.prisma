generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────

enum Transmission {
  AUTOMATIC
  MANUAL
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
}

enum RentalPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

enum BookingStatus {
  PENDING_PAYMENT
  PAYMENT_PROCESSING
  PAID
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProvider {
  FIUU
}

// ─── Models ─────────────────────────────────────────────

model Category {
  id            String   @id @default(cuid())
  nameAr        String
  nameEn        String
  slug          String   @unique
  descriptionAr String?
  descriptionEn String?
  icon          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cars Car[]

  @@map("categories")
}

model Car {
  id              String       @id @default(cuid())
  brand           String
  model           String
  year            Int
  slug            String       @unique
  descriptionAr   String
  descriptionEn   String
  transmission    Transmission
  fuelType        FuelType
  seats           Int
  doors           Int
  engine          String
  luggageCapacity Int
  features        String[]
  isFeatured      Boolean      @default(false)
  isAvailable     Boolean      @default(true)
  categoryId      String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  category Category    @relation(fields: [categoryId], references: [id])
  images   CarImage[]
  pricing  CarPricing?
  bookings Booking[]

  @@index([categoryId])
  @@index([slug])
  @@index([isFeatured])
  @@index([isAvailable])
  @@map("cars")
}

model CarImage {
  id         String   @id @default(cuid())
  carId      String
  url        String
  publicId   String?
  altAr      String?
  altEn      String?
  isPrimary  Boolean  @default(false)
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())

  car Car @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@index([carId])
  @@map("car_images")
}

model CarPricing {
  id              String   @id @default(cuid())
  carId           String   @unique
  dailyRate       Decimal  @db.Decimal(10, 2)
  weeklyRate      Decimal  @db.Decimal(10, 2)
  monthlyRate     Decimal  @db.Decimal(10, 2)
  currency        String   @default("MYR")
  securityDeposit Decimal  @db.Decimal(10, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  car Car @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@map("car_pricing")
}

model Customer {
  id                   String    @id @default(cuid())
  firstName            String
  lastName             String
  fullName             String
  email                String    @unique
  phone                String
  dateOfBirth          DateTime?
  nationality          String?
  passportOrIdNumber   String?
  drivingLicenseNumber String?
  drivingLicenseExpiry DateTime?
  address              String?
  city                 String?
  state                String?
  postcode             String?
  country              String?   @default("Malaysia")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  bookings Booking[]
  payments Payment[]

  @@index([email])
  @@index([phone])
  @@map("customers")
}

model Booking {
  id            String        @id @default(cuid())
  bookingNumber String        @unique
  customerId    String
  carId         String

  pickupDate     DateTime
  pickupTime     String
  returnDate     DateTime
  returnTime     String
  pickupLocation String
  returnLocation String

  rentalAmount   Decimal       @db.Decimal(10, 2)
  depositAmount  Decimal       @db.Decimal(10, 2) @default(0)
  taxAmount      Decimal       @db.Decimal(10, 2) @default(0)
  discountAmount Decimal       @db.Decimal(10, 2) @default(0)
  totalAmount    Decimal       @db.Decimal(10, 2)
  currency       String        @default("MYR")

  status         BookingStatus @default(PENDING_PAYMENT)

  customerNotes  String?
  adminNotes     String?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  paidAt         DateTime?
  cancelledAt    DateTime?
  completedAt    DateTime?
  expiresAt      DateTime?

  customer  Customer  @relation(fields: [customerId], references: [id])
  car       Car       @relation(fields: [carId], references: [id])
  payments  Payment[]

  @@index([customerId])
  @@index([carId])
  @@index([status])
  @@index([bookingNumber])
  @@index([pickupDate])
  @@index([returnDate])
  @@index([createdAt])
  @@map("bookings")
}

model Payment {
  id         String          @id @default(cuid())
  bookingId  String
  customerId String

  amount    Decimal         @db.Decimal(10, 2)
  currency  String          @default("MYR")

  provider        PaymentProvider @default(FIUU)
  paymentMethod   String?

  providerTransactionId String?
  providerReference     String?
  providerOrderId       String?

  status        PaymentStatus @default(PENDING)
  failureReason String?

  paidAt    DateTime?

  refundAmount Decimal?  @db.Decimal(10, 2)
  refundedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking        @relation(fields: [bookingId], references: [id])
  customer Customer      @relation(fields: [customerId], references: [id])
  events  PaymentEvent[]

  @@index([bookingId])
  @@index([customerId])
  @@index([status])
  @@index([providerTransactionId])
  @@index([createdAt])
  @@map("payments")
}

model PaymentEvent {
  id        String @id @default(cuid())
  paymentId String

  eventType             String
  provider              String   @default("FIUU")
  providerTransactionId String?

  verified  Boolean @default(false)
  processed Boolean @default(false)

  payload Json?

  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@index([providerTransactionId])
  @@index([createdAt])
  @@map("payment_events")
}
